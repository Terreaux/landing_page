---
import { ConstructionVisionSection } from '@/islands/landing/ConstructionVisionSection';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Computer Vision Runtime Preview | Terreaux"
  description="Standalone preview page for the Terreaux computer vision reasoning runtime animation."
  mainVariant="playgroundCv"
>
  <section class="w-full max-w-[66rem]">
    <div class="w-full">
      <ConstructionVisionSection
        client:visible
        className="py-0 md:py-0"
        enableReveal={false}
        showBlob={false}
        showHeading={false}
        layout="stacked"
      />
    </div>
  </section>
</SiteLayout>
