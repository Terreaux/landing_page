---
import { HeroChainOfThought } from '@/islands/landing/HeroChainOfThought';
import { heroThoughtScenarios } from '@/data/serviceRuntimes';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Agentic Runtime Preview | Terreaux"
  description="Standalone preview page for the Terreaux agentic chain-of-thought runtime animation."
  mainVariant="playgroundAgentic"
>
  <section class="grid items-start gap-7 xl:grid-cols-2">
    {heroThoughtScenarios.map((scenario, index) => (
      <div class="w-full" data-scenario={scenario.id}>
        <HeroChainOfThought client:visible scenarioIndex={index} cycleScenarios={false} />
      </div>
    ))}
  </section>
</SiteLayout>
