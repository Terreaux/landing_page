---
import { HeroChainOfThought } from '@/components/landing/HeroChainOfThought';
import { SiteHeader } from '@/components/SiteHeader';
import { heroThoughtScenarios } from '@/data/serviceRuntimes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getRootPath } from '@/lib/utils';

const rootPath = getRootPath();
---

<BaseLayout
  title="Agentic Runtime Preview | Terreaux"
  description="Standalone preview page for the Terreaux agentic chain-of-thought runtime animation."
>
  <div class="site-bg" aria-hidden="true" />
  <SiteHeader client:load rootPath={rootPath} />
  <main class="mx-auto w-[min(1700px,96vw)] pb-24 pt-12 text-[#f7f9f2] md:pb-32 md:pt-16">
    <section class="grid items-start gap-7 xl:grid-cols-2">
      {heroThoughtScenarios.map((scenario, index) => (
        <div class="w-full" data-scenario={scenario.id}>
          <HeroChainOfThought client:load scenarioIndex={index} cycleScenarios={false} />
        </div>
      ))}
    </section>
  </main>
</BaseLayout>
